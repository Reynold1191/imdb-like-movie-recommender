# Copy this file to .env and fill in real values.

# ── TMDB API ──────────────────────────────────────────────────────────────────
# Bearer token from https://www.themoviedb.org/settings/api
TMDB_ACCESS_TOKEN=your_tmdb_read_access_token_here

# ── PostgreSQL (Docker container) ─────────────────────────────────────────────
POSTGRES_DB=movie_recommender
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password_here
# Port exposed on host (use 5433 if local Postgres already occupies 5432)
POSTGRES_PORT=5433

# ── pgAdmin 4 ──────────────────────────────────────────────────────────────────
PGADMIN_DEFAULT_EMAIL=admin@movie.local
PGADMIN_DEFAULT_PASSWORD=admin

# ── Flask (Docker `web` service) ─────────────────────────────────────────────
# Used for session signing; override in production
SECRET_KEY=change-me-in-production
